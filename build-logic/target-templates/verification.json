{
  "mod_id": "yungslegacybootstrap",
  "base_package": "com.glowingfederal.yungslegacy",
  "display_name": "YUNG's Legacy Bootstrap",
  "archive_pattern": "{mod_id}-{full_version}+mc{mc}-{loader}.jar",
  "version_class": "{package_path}/BuildVersion.class",
  "required_classes": [
    "{package_path}/LegacyBootstrap.class",
    "{package_path}/BootstrapCommand.class"
  ],
  "required_shared_classes": [
    "{package_path}/domain/BootstrapInfo.class"
  ],
  "class_roots": [
    "{package_path}/"
  ],
  "resource_roots": [
    "assets/{mod_id}/"
  ],
  "required_assets": [
    "assets/{mod_id}/bootstrap.properties",
    "META-INF/licenses/LICENSE"
  ],
  "metadata_profiles": {
    "legacy": {
      "path": "mcmod.info",
      "json_values": {
        "0.modid": "{mod_id}",
        "0.name": "{display_name}",
        "0.version": "{full_version}",
        "0.mcversion": "{mc}",
        "0.requiredMods": [],
        "0.dependencies": [],
        "0.dependants": []
      }
    }
  },
  "targets": {
    "1.6.4": {
      "metadata_profile": "legacy",
      "required_classes": [],
      "required_assets": [],
      "json_checks": [],
      "remapping": {
        "required": true,
        "checks": [
          {
            "class": "{package_path}/BootstrapCommand.class",
            "present": [
              "func_71518_a"
            ],
            "absent": [
              "getCommandName"
            ]
          }
        ]
      }
    },
    "1.8.9": {
      "metadata_profile": "legacy",
      "required_classes": [],
      "required_assets": [],
      "json_checks": [],
      "remapping": {
        "required": true,
        "checks": [
          {
            "class": "{package_path}/BootstrapCommand.class",
            "present": [
              "func_71518_a"
            ],
            "absent": [
              "getCommandName"
            ]
          }
        ]
      }
    }
  },
  "forbidden_roots": [
    "reference/",
    "com/yungnickyoung/",
    "assets/yungsapi/",
    "data/yungsapi/"
  ]
}
